# --- Terraform ---
# State can contain secrets (generated passwords). NEVER commit it.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
crash.log
crash.*.log

# Your real variables (contains your IP). Commit only terraform.tfvars.example.
terraform.tfvars
*.auto.tfvars

# --- Credentials / keys ---
*.pem
*.ppk
id_rsa*
*_key
*.key

# Personal scratch notes (contain pasted passwords / enrollment tokens).
docs/detection-lab-notes.txt

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- AI tooling (local agent skills, not part of the lab) ---
.agents/
.claude/
skills-lock.json
